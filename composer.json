{
    "name": "bertrapp/corretor-php",
    "description": "Analisa projetos PHP/Laravel e aponta (e ajuda a corrigir) violações das convenções do time.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Corretor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Corretor\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/corretor"
    ]
}
