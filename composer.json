{
    "name": "bertrapp/corretor-php",
    "description": "Padrão de código verificável por ferramenta: analisa projetos Laravel e Node/TypeScript e aponta violações das convenções do time.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "nikic/php-parser": "^5.0",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Corretor\\": "src/",
            "Corretor\\Stacks\\Laravel\\": "stacks/laravel/src/",
            "Corretor\\Stacks\\Node\\": "stacks/node/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Corretor\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/corretor"
    ],
    "suggest": {
        "ast-grep/cli (npm @ast-grep/cli)": "Necessário para analisar a stack node."
    }
}
